{
  "_meta": {
    "description": "Golden test set for MAC M2M Assistant eval harness",
    "version": "1.0.0",
    "prompt_version": "2.1.0",
    "instructions": "Run with: node eval.js — each test verifies safety, schema validity, and expected SQL patterns"
  },
  "tests": [
    {
      "id": "m2m-001",
      "question": "Show me all open sales orders",
      "database": "m2mdata99",
      "expect_tables": ["SOMAST"],
      "expect_columns_any": ["FSONO", "FCOMPANY", "FSTATUS"],
      "expect_where_patterns": ["FSTATUS"],
      "must_not_contain": ["PREMPL", "GLMAST", "INSERT", "DELETE"],
      "expect_aliases": true,
      "category": "basic-filter"
    },
    {
      "id": "m2m-002",
      "question": "How many purchase orders did we place this month?",
      "database": "m2mdata99",
      "expect_tables": ["POMAST"],
      "expect_columns_any": ["COUNT"],
      "expect_where_patterns": ["FORDDATE", "DATEADD\\(|DATEDIFF\\(|GETDATE"],
      "must_not_contain": ["FDUEDATE"],
      "expect_aliases": true,
      "category": "aggregate-date"
    },
    {
      "id": "m2m-003",
      "question": "Show me late sales orders",
      "database": "m2mdata99",
      "expect_tables": ["SOMAST"],
      "expect_columns_any": ["FSONO", "FDUEDATE"],
      "expect_where_patterns": ["GETDATE", "FDUEDATE"],
      "must_not_contain": ["PREMPL"],
      "expect_aliases": true,
      "category": "date-comparison"
    },
    {
      "id": "m2m-004",
      "question": "What parts are on hand with less than 10 quantity?",
      "database": "m2mdata99",
      "expect_tables": ["INONHD"],
      "expect_columns_any": ["FONHAND", "FPARTNO"],
      "expect_where_patterns": ["FONHAND"],
      "must_not_contain": ["F2LABCOST", "FAVGCOST"],
      "expect_aliases": true,
      "category": "inventory"
    },
    {
      "id": "m2m-005",
      "question": "Show me all jobs for sales order 123456",
      "database": "m2mdata99",
      "expect_tables": ["JOMAST"],
      "expect_columns_any": ["FJOBNO", "FSONO"],
      "expect_where_patterns": ["FSONO", "123456"],
      "must_not_contain": [],
      "expect_aliases": true,
      "category": "join-lookup"
    },
    {
      "id": "m2m-006",
      "question": "List all customer invoices",
      "database": "m2mdata99",
      "expect_tables": ["ARMAST"],
      "expect_columns_any": ["FCUSTNO", "FCCOMPANY"],
      "expect_where_patterns": [],
      "must_not_contain": ["PREMPL", "CCINFO"],
      "expect_aliases": true,
      "note": "ARCUST is referenced in query_rules but is not in the slim schema. ARMAST is the actual customer invoice table. This is a known schema gap.",
      "category": "basic-list"
    },
    {
      "id": "m2m-007",
      "question": "Show me PO line items for PO number 001234",
      "database": "m2mdata99",
      "expect_tables": ["POITEM"],
      "expect_columns_any": ["FPONO", "FPARTNO"],
      "expect_where_patterns": ["FPONO", "001234"],
      "must_not_contain": ["FDUEDATE"],
      "expect_aliases": true,
      "category": "specific-lookup"
    },
    {
      "id": "m2m-008",
