{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/mac_logo.png", "/mac_impulse_logo.png", "/UniPointlogo.png"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff"
  },
  "routes": [
    {
      "route": "/assets/*.js",
      "headers": {
        "Content-Type": "text/javascript"
      }
    }
  ]
}
